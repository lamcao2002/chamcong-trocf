# Sao chép thành .env.local rồi điền giá trị. KHÔNG commit .env.local.
# Ba môi trường: local (máy bạn) · staging (Supabase staging + Vercel Preview) · production (Sprint 4)

# local | staging | production
APP_ENV=local

# --- CSDL ---------------------------------------------------------------
# Máy bạn (docker compose):
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chamcong
# Supabase: dùng Transaction pooler, cổng 6543, ví dụ:
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Kết nối trực tiếp cho migration (Supabase: Session pooler cổng 5432 hoặc Direct connection).
# Bỏ trống thì dùng DATABASE_URL.
DATABASE_URL_DIRECT=
# DATABASE_URL_DIRECT=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# --- Ứng dụng -----------------------------------------------------------
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Khoá của cron tính lại ngày công (tối thiểu 16 ký tự). Đặt trên Vercel; máy bạn để trống cũng được.
CRON_SECRET=

# Chỉ dùng khi chạy test ở máy (APP_ENV=local): 1 = đợt đăng ký ca luôn mở. Staging, production bỏ trống.
REGISTRATION_ALWAYS_OPEN=

# PIN chung cho tài khoản mẫu của npm run db:seed (4–8 số). Bắt buộc khi APP_ENV=staging; local mặc định 1234.
SEED_PIN=
